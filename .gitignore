# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Vercel
.vercel

# Local verification screenshots written to the repo root by QA passes.
# Project imagery lives in src/assets and public, so a root-only rule is safe.
/*.png
responsive-evidence/
.playwright-mcp/
# Captured `npm run verify` output kept for the run it belongs to.
/.responsive-verify.txt

# One-off codemod/patch scripts kept while building; not part of the app.
# The exception is the doc-figures gate: `npm run verify` runs it, so it is part
# of the app's verification and has to be in the repository, or a fresh clone
# gets a verify script that cannot run.
scripts/*
!scripts/audit-doc-figures.mjs

# Local env files. These carry the waitlist webhook URL and anything added
# later; only the committed template is tracked.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
